import 'package:flutter/material.dart';
import 'package:go_router/go_router.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:intl/intl.dart';

import '../../core/constants/currencies.dart';
import '../../core/utils/money.dart';
import '../../data/db/centli_database.dart';
import '../../data/db/database_provider.dart';
import 'ai_text_fill.dart';
import 'llm_text_fill.dart';
import 'local_speech.dart';

Future<void> showBookkeepingSheet(
  BuildContext context, {
  Transaction? existing,
}) {
  return showModalBottomSheet<void>(
    context: context,
    isScrollControlled: true,
    useSafeArea: true,
    builder: (context) => BookkeepingSheet(existing: existing),
  );
}

class BookkeepingSheet extends ConsumerStatefulWidget {
  const BookkeepingSheet({super.key, this.existing});

  final Transaction? existing;

  @override
  ConsumerState<BookkeepingSheet> createState() => _BookkeepingSheetState();
}

class _BookkeepingSheetState extends ConsumerState<BookkeepingSheet> {
  String _type = 'out';
  String _amountText = '0';
  String _toAmountText = '0';
  String? _fxRateText;
  /// When cross-ccy: user enters to_amount (true) or fx_rate (false).
  bool _useToAmount = true;
  String? _accountId;
  String? _toAccountId;
  String? _categoryId;
  final _noteCtrl = TextEditingController();
  final _aiTextCtrl = TextEditingController();
  bool _aiExpanded = false;
  int _fieldEpoch = 0;
  final _speech = LocalSpeechService();
  var _speechListening = false;
  var _speechBusy = false;
  var _aiFilling = false;
  List<Account> _accounts = [];
  List<Category> _categories = [];
  String? _ledgerId;
  bool _loading = true;
  bool _saving = false;
  DateTime _happenAt = DateTime.now();

  @override
  void initState() {
    super.initState();
    _load();
  }

  @override
  void dispose() {
    _noteCtrl.dispose();
    _aiTextCtrl.dispose();
    _speech.cancel();
    super.dispose();
  }

  Future<void> _load() async {
    final db = ref.read(databaseProvider);
    final ledgerId = await db.currentLedgerId();
    if (ledgerId == null) {
      setState(() => _loading = false);
      return;
    }
    final accounts = await db.loadActiveAccounts(ledgerId);
    final cats =
        await db.loadCategories(ledgerId, _type == 'in' ? 'in' : 'out');
    if (!mounted) return;
    final existing = widget.existing;
    setState(() {
      _ledgerId = ledgerId;
      _accounts = accounts;
      if (existing != null) {
        _type = existing.type;
        _amountText = fromMinor(existing.currency, existing.amountMinor)
            .toStringAsFixed(currencyDecimals[existing.currency] ?? 2);
        // trim trailing zeros from whole amounts
        if (_amountText.contains('.')) {
          _amountText = _amountText.replaceFirst(RegExp(r'\.?0+$'), '');
          if (_amountText.isEmpty) _amountText = '0';
        }
        _accountId = existing.accountId;
        _toAccountId = existing.toAccountId;
        _categoryId = existing.categoryId;
        _noteCtrl.text = existing.note ?? '';
        _happenAt = DateTime.fromMillisecondsSinceEpoch(
          existing.happenAt,
          isUtc: true,
        ).toLocal();
        if (existing.toAmountMinor != null) {
          final toAcc = accounts.where((a) => a.id == existing.toAccountId);
          final toCcy = toAcc.isNotEmpty ? toAcc.first.currency : existing.currency;
          _toAmountText = fromMinor(toCcy, existing.toAmountMinor!)
              .toStringAsFixed(currencyDecimals[toCcy] ?? 2);
        }
        if (existing.fxRate != null) {
          _fxRateText = existing.fxRate.toString();
        }
      } else {
        _accountId = accounts.isNotEmpty ? accounts.first.id : null;
        _toAccountId = accounts.length > 1 ? accounts[1].id : null;
        _categoryId = cats.isNotEmpty ? cats.first.id : null;
      }
      _categories = cats;
      // reload cats for existing type (may differ from default out)
      _loading = false;
    });
    if (existing != null && existing.type != 'out') {
      await _reloadCategories();
      if (existing.categoryId != null) {
        setState(() => _categoryId = existing.categoryId);
      }
    }
  }

  Future<void> _reloadCategories() async {
    if (_ledgerId == null || _type == 'transfer') return;
    final db = ref.read(databaseProvider);
    final cats =
        await db.loadCategories(_ledgerId!, _type == 'in' ? 'in' : 'out');
    setState(() {
      _categories = cats;
      _categoryId = cats.isNotEmpty ? cats.first.id : null;
    });
  }

  Account? _accountById(String? id) {
    if (id == null || _accounts.isEmpty) return null;
    for (final a in _accounts) {
      if (a.id == id) return a;
    }
    return null;
  }

  String get _currency {
    return _accountById(_accountId)?.currency ?? 'CNY';
  }

  String get _toCurrency {
    return _accountById(_toAccountId)?.currency ?? _currency;
  }

  bool get _isCrossCurrency {
    if (_type != 'transfer') return false;
    final from = _accountById(_accountId);
    final to = _accountById(_toAccountId);
    if (from == null || to == null) return false;
    return from.currency != to.currency;
  }

  int get _maxDecimals => currencyDecimals[_currency] ?? 2;

  void _onKey(String key) {
    setState(() {
      if (key == '+' || key == '-') {
        _amountText = _applyOperator(_amountText, key);
      } else {
        _amountText = _applyKey(_amountText, key, _maxDecimals);
      }
    });
  }

  /// Left-to-right + / - over non-negative operands (calculator-style keypad).
  double? _evalAmount(String expr) {
    var s = expr.trim();
    if (s.endsWith('+') || s.endsWith('-')) {
      s = s.substring(0, s.length - 1);
    }
    if (s.isEmpty) return null;
    final tokens = <String>[];
    final buf = StringBuffer();
    for (var i = 0; i < s.length; i++) {
      final c = s[i];
      if (c == '+' || c == '-') {
        if (buf.isEmpty) return null;
        tokens.add(buf.toString());
        tokens.add(c);
        buf.clear();
      } else {
        buf.write(c);
      }
    }
    if (buf.isEmpty) return null;
    tokens.add(buf.toString());

    final first = double.tryParse(tokens.first);
    if (first == null) return null;
    var acc = first;
    for (var i = 1; i + 1 < tokens.length; i += 2) {
      final op = tokens[i];
      final n = double.tryParse(tokens[i + 1]);
      if (n == null) return null;
      if (op == '+') {
        acc += n;
      } else {
        acc -= n;
      }
    }
    return acc;
  }

  bool get _amountHasOperator {
    final s = _amountText;
    for (var i = 0; i < s.length; i++) {
      final c = s[i];
      if (c == '+' || c == '-') return true;
    }
    return false;
  }

  int _lastOperatorIndex(String s) {
    for (var i = s.length - 1; i >= 0; i--) {
      final c = s[i];
      if (c == '+' || c == '-') return i;
    }
    return -1;
  }

  String _applyOperator(String current, String op) {
    if (current.isEmpty || current == '0') return '0';
    if (current.endsWith('+') || current.endsWith('-')) {
      return '${current.substring(0, current.length - 1)}$op';
    }
    var s = current;
    if (s.endsWith('.')) {
      s = s.substring(0, s.length - 1);
    }
    if (s.isEmpty) return '0';
    return '$s$op';
  }

  String _applyDigitToOperand(String operand, String key, int maxDecimals) {
    if (key == '\u232b') {
      if (operand.length <= 1) return '0';
      return operand.substring(0, operand.length - 1);
    }
    if (key == '.') {
      if (maxDecimals == 0) return operand;
      if (!operand.contains('.')) return '$operand.';
      return operand;
    }
    if (key == '00') {
      if (operand == '0') return operand;
      final parts = operand.split('.');
      if (parts.length == 2) {
        final room = maxDecimals - parts[1].length;
        if (room <= 0) return operand;
        return '$operand${'0' * room}';
      }
      if (operand.length >= 12) return operand;
      return '${operand}00';
    }
    if (operand == '0') return key;
    final parts = operand.split('.');
    if (parts.length == 2 && parts[1].length >= maxDecimals) return operand;
    if (operand.length >= 12) return operand;
    return '$operand$key';
  }

  String _applyKey(String current, String key, int maxDecimals) {
    if (key == '\u232b') {
      if (current.isEmpty || current == '0') return '0';
      if (current.endsWith('+') || current.endsWith('-')) {
        return current.substring(0, current.length - 1);
      }
      final opIdx = _lastOperatorIndex(current);
      if (opIdx < 0) {
        return _applyDigitToOperand(current, key, maxDecimals);
      }
      final prefix = current.substring(0, opIdx + 1);
      final operand = current.substring(opIdx + 1);
      if (operand.length <= 1) {
        // Drop last digit of operand; leave trailing operator.
        return prefix;
      }
      return '$prefix${_applyDigitToOperand(operand, key, maxDecimals)}';
    }

    final opIdx = _lastOperatorIndex(current);
    final prefix = opIdx < 0 ? '' : current.substring(0, opIdx + 1);
    var operand = opIdx < 0 ? current : current.substring(opIdx + 1);
    if (operand.isEmpty) operand = '0';
    operand = _applyDigitToOperand(operand, key, maxDecimals);
    return '$prefix$operand';
  }

  Future<void> _promptCrossCurrency({bool keepOpen = false}) async {
    final fromCcy = _currency;
    final toCcy = _toCurrency;
    final major = _evalAmount(_amountText) ?? 0;
    final toCtrl = TextEditingController(
      text: _toAmountText == '0' ? '' : _toAmountText,
    );
    final rateCtrl = TextEditingController(text: _fxRateText ?? '');
    var useTo = _useToAmount;

    final ok = await showDialog<bool>(
      context: context,
      builder: (ctx) {
        return StatefulBuilder(
          builder: (ctx, setLocal) {
            return AlertDialog(
              title: Text('\u8de8\u5e01\u8f6c\u8d26 ($fromCcy \u2192 $toCcy)'),
              content: Column(
                mainAxisSize: MainAxisSize.min,
                children: [
                  Text(
                    '\u8f6c\u51fa ${formatMinor(fromCcy, toMinor(fromCcy, major))}',
                    style: Theme.of(ctx).textTheme.bodyMedium,
                  ),
                  const SizedBox(height: 12),
                  SegmentedButton<bool>(
                    segments: const [
                      ButtonSegment(
                        value: true,
                        label: Text('\u5bf9\u65b9\u91d1\u989d'),
                      ),
                      ButtonSegment(
                        value: false,
                        label: Text('\u6c47\u7387'),
                      ),
                    ],
                    selected: {useTo},
                    onSelectionChanged: (s) => setLocal(() => useTo = s.first),
                  ),
                  const SizedBox(height: 12),
                  if (useTo)
                    TextField(
                      controller: toCtrl,
                      keyboardType:
                          const TextInputType.numberWithOptions(decimal: true),
                      decoration: InputDecoration(
                        labelText: '\u8f6c\u5165\u91d1\u989d ($toCcy)',
                        border: const OutlineInputBorder(),
                      ),
                    )
                  else
                    TextField(
                      controller: rateCtrl,
                      keyboardType:
                          const TextInputType.numberWithOptions(decimal: true),
                      decoration: InputDecoration(
                        labelText: '1 $fromCcy = ? $toCcy',
                        border: const OutlineInputBorder(),
                      ),
                    ),
                ],
              ),
              actions: [
                TextButton(
                  onPressed: () => Navigator.pop(ctx, false),
                  child: const Text('\u53d6\u6d88'),
                ),
                FilledButton(
                  onPressed: () => Navigator.pop(ctx, true),
                  child: const Text('\u786e\u5b9a'),
                ),
              ],
            );
          },
        );
      },
    );

    if (ok != true) return;
    setState(() {
      _useToAmount = useTo;
      if (useTo) {
        _toAmountText = toCtrl.text.trim().isEmpty ? '0' : toCtrl.text.trim();
        _fxRateText = null;
      } else {
        _fxRateText = rateCtrl.text.trim();
        _toAmountText = '0';
      }
    });
    toCtrl.dispose();
    rateCtrl.dispose();
    await _save(skipCrossPrompt: true, keepOpen: keepOpen);
  }

  Future<void> _save({bool skipCrossPrompt = false, bool keepOpen = false}) async {
    final major = _evalAmount(_amountText);
    if (major == null || major <= 0) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('\u8bf7\u8f93\u5165\u91d1\u989d')),
      );
      return;
    }
    // Collapse expression to evaluated major so subsequent FX math uses a plain number.
    if (_amountHasOperator) {
      final decimals = _maxDecimals;
      var collapsed = major.toStringAsFixed(decimals);
      if (decimals > 0) {
        collapsed = collapsed.replaceFirst(RegExp(r'\.?0+$'), '');
        if (collapsed.isEmpty) collapsed = '0';
      }
      _amountText = collapsed;
    }
    if (_ledgerId == null || _accountId == null) return;

    if (_type == 'transfer') {
      if (_toAccountId == null) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(content: Text('\u8bf7\u9009\u62e9\u8f6c\u5165\u8d26\u6237')),
        );
        return;
      }
      if (_toAccountId == _accountId) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(content: Text('\u8f6c\u51fa\u4e0e\u8f6c\u5165\u8d26\u6237\u4e0d\u80fd\u76f8\u540c')),
        );
        return;
      }
      if (_isCrossCurrency && !skipCrossPrompt) {
        final hasTo = (double.tryParse(_toAmountText) ?? 0) > 0;
        final hasRate = (double.tryParse(_fxRateText ?? '') ?? 0) > 0;
        if (!hasTo && !hasRate) {
          await _promptCrossCurrency(keepOpen: keepOpen);
          return;
        }
      }
    } else if (_categoryId == null) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('\u8bf7\u9009\u62e9\u5206\u7c7b')),
      );
      return;
    }

    setState(() => _saving = true);
    try {
      final db = ref.read(databaseProvider);
      final amountMinor = toMinor(_currency, major);
      double? fxRate;
      int? toAmountMinor;

      if (_type == 'transfer' && _isCrossCurrency) {
        if (_useToAmount || (double.tryParse(_toAmountText) ?? 0) > 0) {
          final toMajor = double.tryParse(_toAmountText) ?? 0;
          if (toMajor <= 0) {
            ScaffoldMessenger.of(context).showSnackBar(
              const SnackBar(content: Text('\u8bf7\u8f93\u5165\u5bf9\u65b9\u91d1\u989d')),
            );
            return;
          }
          toAmountMinor = toMinor(_toCurrency, toMajor);
          fxRate = toMajor / major; // 1 from = rate to
        } else {
          fxRate = double.tryParse(_fxRateText ?? '');
          if (fxRate == null || fxRate <= 0) {
            ScaffoldMessenger.of(context).showSnackBar(
              const SnackBar(content: Text('\u8bf7\u8f93\u5165\u6709\u6548\u6c47\u7387')),
            );
            return;
          }
          toAmountMinor = toMinor(_toCurrency, major * fxRate);
        }
      } else if (_type == 'transfer') {
        toAmountMinor = amountMinor;
      }

      final note =
          _noteCtrl.text.trim().isEmpty ? null : _noteCtrl.text.trim();
      final toAcc = _type == 'transfer' ? _toAccountId : null;
      final cat = _type == 'transfer' ? null : _categoryId;
      if (widget.existing != null) {
        await db.updateManualTransaction(
          id: widget.existing!.id,
          type: _type,
          amountMinor: amountMinor,
          currency: _currency,
          accountId: _accountId!,
          toAccountId: toAcc,
          categoryId: cat,
          note: note,
          happenAt: _happenAt,
          fxRate: fxRate,
          toAmountMinor: toAmountMinor,
        );
      } else {
        await db.insertManualTransaction(
          ledgerId: _ledgerId!,
          type: _type,
          amountMinor: amountMinor,
          currency: _currency,
          accountId: _accountId!,
          toAccountId: toAcc,
          categoryId: cat,
          note: note,
          happenAt: _happenAt,
          fxRate: fxRate,
          toAmountMinor: toAmountMinor,
        );
      }
      if (!mounted) return;
      if (keepOpen && widget.existing == null) {
        // 再记一笔：落库后保留面板，清空金额/备注，时间刷新为现在。
        setState(() {
          _amountText = '0';
          _toAmountText = '0';
          _fxRateText = null;
          _noteCtrl.clear();
          _happenAt = DateTime.now();
        });
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(content: Text('已保存，可继续记账')),
        );
      } else {
        Navigator.of(context).pop();
      }
    } finally {
      if (mounted) setState(() => _saving = false);
    }
  }

  String get _happenAtLabel {
    final now = DateTime.now();
    final sameDay = _happenAt.year == now.year &&
        _happenAt.month == now.month &&
        _happenAt.day == now.day;
    if (sameDay) {
      return DateFormat('HH:mm').format(_happenAt);
    }
    return DateFormat('yyyy-MM-dd HH:mm').format(_happenAt);
  }

  Future<void> _pickHappenAt() async {
    final date = await showDatePicker(
      context: context,
      initialDate: _happenAt,
      firstDate: DateTime(2020, 1, 1),
      lastDate: DateTime.now().add(const Duration(days: 365)),
      helpText: '选择日期',
    );
    if (date == null || !mounted) return;
    final time = await showTimePicker(
      context: context,
      initialTime: TimeOfDay.fromDateTime(_happenAt),
      helpText: '选择时间',
    );
    if (time == null || !mounted) return;
    setState(() {
      _happenAt = DateTime(
        date.year,
        date.month,
        date.day,
        time.hour,
        time.minute,
      );
    });
  }



  Future<void> _toggleVoiceFill() async {
    if (_speechListening) {
      await _stopSpeech();
      return;
    }
    if (_speechBusy) return;
    setState(() => _speechBusy = true);
    try {
      final ok = await _speech.ensureReady();
      if (!mounted) return;
      if (!ok) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
            content: Text(
              '\u5f53\u524d\u8bbe\u5907\u4e0d\u652f\u6301\u8bed\u97f3\u8bc6\u522b\uff0c\u8bf7\u6539\u7528\u6587\u5b57\u8bdd\u672f',
            ),
          ),
        );
        return;
      }
      setState(() {
        _aiExpanded = true;
        _speechListening = true;
      });
      await _speech.start(
        onResult: (r) {
          if (!mounted) return;
          setState(() {
            _aiTextCtrl.text = r.text;
            _aiTextCtrl.selection = TextSelection.collapsed(
              offset: _aiTextCtrl.text.length,
            );
          });
          if (r.finalResult && r.text.trim().isNotEmpty) {
            _stopSpeech().then((_) {
              if (mounted) _applyAiTextFill();
            });
          }
        },
      );
    } catch (e) {
      if (!mounted) return;
      setState(() => _speechListening = false);
      final detail = _speech.lastError;
      final msg = detail == null || detail.isEmpty
          ? '\u8bed\u97f3\u8bc6\u522b\u5931\u8d25: $e'
          : '\u8bed\u97f3\u8bc6\u522b\u5931\u8d25: $e\n$detail';
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text(msg)),
      );
    } finally {
      if (mounted) setState(() => _speechBusy = false);
    }
  }

  Future<void> _stopSpeech() async {
    try {
      await _speech.stop();
    } catch (_) {}
    if (mounted) {
      setState(() => _speechListening = false);
    } else {
      _speechListening = false;
    }
  }

  Future<void> _applyAiTextFill() async {
    final raw = _aiTextCtrl.text.trim();
    if (raw.isEmpty) {
      ScaffoldMessenger.of(context).showSnackBar(
        const SnackBar(content: Text('请先输入记账话术')),
      );
      return;
    }
    if (_ledgerId == null) return;
    if (_aiFilling) return;

    setState(() => _aiFilling = true);
    try {
      final db = ref.read(databaseProvider);
      final outCats = await db.loadCategories(_ledgerId!, 'out');
      final inCats = await db.loadCategories(_ledgerId!, 'in');
      final catRefs = <CategoryRef>[
        for (final c in outCats)
          CategoryRef(
            name: c.name,
            id: c.id,
            parentId: c.parentId,
            kind: c.kind,
          ),
        for (final c in inCats)
          CategoryRef(
            name: c.name,
            id: c.id,
            parentId: c.parentId,
            kind: c.kind,
          ),
      ];
      final allCatNames = catRefs.map((c) => c.name).toList();
      final accountNames = _accounts.map((a) => a.name).toList();

      // Local parse first (always available as fallback).
      var parsed = parseBookkeepingText(
        raw,
        categoryNames: allCatNames,
        categories: catRefs,
        accountNames: accountNames,
      );

      // Optional LLM enhancement when configured.
      try {
        final llmSettings = SmartFillLlmSettings();
        final cfg = await llmSettings.load(db);
        if (cfg.isReady) {
          final llm = await parseBookkeepingTextWithLlm(
            raw,
            config: cfg,
            categoryNames: allCatNames,
            categories: catRefs,
            accountNames: accountNames,
          );
          if (llm != null && llm.hasUsefulFill) {
            parsed = llm;
          }
        }
      } catch (_) {
        // Keep local parse; never block fill/save on LLM errors.
      }

      if (!parsed.hasUsefulFill) {
        if (!mounted) return;
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(content: Text('未能识别，请换种说法或手动填写')),
        );
        return;
      }

      final nextType = parsed.type ?? _type;
      List<Category> cats = _categories;
      if (nextType != 'transfer') {
        cats = await db.loadCategories(
          _ledgerId!,
          nextType == 'in' ? 'in' : 'out',
        );
      }

      // Only set category when confident; otherwise leave unset (do NOT guess first).
      String? categoryId;
      var categoryResolved = false;
      if (parsed.hasConfidentCategory && nextType != 'transfer') {
        Category? hit;
        for (final c in cats) {
          if (c.name == parsed.categoryName) {
            hit = c;
            break;
          }
        }
        hit ??= () {
          for (final c in cats) {
            if (c.name.contains(parsed.categoryName!) ||
                parsed.categoryName!.contains(c.name)) {
              return c;
            }
          }
          return null;
        }();
        if (hit != null) {
          categoryId = hit.id;
          categoryResolved = true;
        }
      }

      // Merchant rule may override category for expense/income.
      if (parsed.merchant != null &&
          parsed.merchant!.trim().isNotEmpty &&
          nextType != 'transfer') {
        final key = parsed.merchant!
            .trim()
            .toLowerCase()
            .replaceAll(RegExp(r'\s+'), ' ');
        final rule = await db.findMerchantRule(_ledgerId!, key);
        if (rule?.categoryId != null) {
          final id = rule!.categoryId!;
          if (cats.any((c) => c.id == id)) {
            categoryId = id;
            categoryResolved = true;
          }
        }
      }

      String? accountId = _accountId;
      String? toAccountId = _toAccountId;
      if (parsed.accountName != null) {
        for (final a in _accounts) {
          if (a.name == parsed.accountName) {
            accountId = a.id;
            break;
          }
        }
      }
      if (parsed.toAccountName != null) {
        for (final a in _accounts) {
          if (a.name == parsed.toAccountName) {
            toAccountId = a.id;
            break;
          }
        }
      }
      // Merchant-rule account if still default and rule has one.
      if (parsed.merchant != null && parsed.merchant!.trim().isNotEmpty) {
        final key = parsed.merchant!
            .trim()
            .toLowerCase()
            .replaceAll(RegExp(r'\s+'), ' ');
        final rule = await db.findMerchantRule(_ledgerId!, key);
        if (rule?.accountId != null &&
            _accounts.any((a) => a.id == rule!.accountId)) {
          if (parsed.accountName == null) {
            accountId = rule!.accountId;
          }
        }
      }

      String amountText = _amountText;
      if (parsed.amount != null) {
        var s = parsed.amount!.toStringAsFixed(2);
        s = s.replaceFirst(RegExp(r'\.?0+$'), '');
        if (s.isEmpty) s = '0';
        amountText = s;
      }

      // Note = leftover remark only. Merchant is separate (shown in hits / rules).
      // If leftover empty but merchant present, put merchant into note for visibility
      // in the single note field (manual insert has no dedicated merchant UI).
      final leftover = parsed.note?.trim();
      final String noteText;
      if (leftover != null && leftover.isNotEmpty) {
        noteText = leftover;
      } else if (parsed.merchant != null && parsed.merchant!.trim().isNotEmpty) {
        noteText = parsed.merchant!.trim();
      } else {
        noteText = '';
      }

      if (!mounted) return;
      setState(() {
        _type = nextType;
        _categories = cats;
        if (nextType == 'transfer') {
          _categoryId = null;
        } else if (categoryResolved) {
          _categoryId = categoryId;
        } else {
          // Unset rather than wrong guess (e.g. always first = 餐饮).
          _categoryId = null;
        }
        _accountId = accountId;
        _toAccountId = toAccountId;
        _amountText = amountText;
        _noteCtrl.text = noteText;
        if (parsed.happenAt != null) {
          _happenAt = parsed.happenAt!;
        }
        _fieldEpoch++;
        _aiExpanded = false;
      });

      final summary =
          parsed.hits.isEmpty ? '已预填' : '已预填：${parsed.hits.join(' · ')}';
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text(summary)),
      );
    } finally {
      if (mounted) setState(() => _aiFilling = false);
    }
  }

  @override
  Widget build(BuildContext context) {
    final scheme = Theme.of(context).colorScheme;
    final height = MediaQuery.sizeOf(context).height * 0.92;

    return SizedBox(
      height: height,
      child: _loading
          ? const Center(child: CircularProgressIndicator())
          : Column(
              children: [
                const SizedBox(height: 8),
                Container(
                  width: 40,
                  height: 4,
                  decoration: BoxDecoration(
                    color: scheme.outlineVariant,
                    borderRadius: BorderRadius.circular(2),
                  ),
                ),
                Padding(
                  padding: const EdgeInsets.fromLTRB(8, 8, 8, 0),
                  child: Row(
                    children: [
                      Expanded(
                        child: SegmentedButton<String>(
                          segments: const [
                            ButtonSegment(
                                value: 'out', label: Text('\u652f\u51fa')),
                            ButtonSegment(
                                value: 'in', label: Text('\u6536\u5165')),
                            ButtonSegment(
                                value: 'transfer', label: Text('\u8f6c\u8d26')),
                          ],
                          selected: {_type},
                          onSelectionChanged: (s) {
                            setState(() => _type = s.first);
                            _reloadCategories();
                          },
                        ),
                      ),
                      IconButton(
                        onPressed: () => Navigator.pop(context),
                        icon: const Icon(Icons.close),
                      ),
                    ],
                  ),
                ),

                Padding(
                  padding: const EdgeInsets.fromLTRB(16, 8, 16, 0),
                  child: Column(
                    crossAxisAlignment: CrossAxisAlignment.stretch,
                    children: [
                      InkWell(
                        onTap: () =>
                            setState(() => _aiExpanded = !_aiExpanded),
                        borderRadius: BorderRadius.circular(8),
                        child: Padding(
                          padding: const EdgeInsets.symmetric(vertical: 6),
                          child: Row(
                            children: [
                              Icon(
                                Icons.auto_awesome,
                                size: 18,
                                color: scheme.primary,
                              ),
                              const SizedBox(width: 8),
                              Expanded(
                                child: Text(
                                  '智能填单',
                                  style: Theme.of(context)
                                      .textTheme
                                      .labelLarge
                                      ?.copyWith(color: scheme.primary),
                                ),
                              ),
                              Text(
                                '话术/语音 · 本地/大模型',
                                style: Theme.of(context)
                                    .textTheme
                                    .bodySmall
                                    ?.copyWith(
                                      color: scheme.onSurfaceVariant,
                                    ),
                              ),
                              Icon(
                                _aiExpanded
                                    ? Icons.expand_less
                                    : Icons.expand_more,
                                color: scheme.onSurfaceVariant,
                              ),
                            ],
                          ),
                        ),
                      ),
                      if (_aiExpanded) ...[
                        const SizedBox(height: 6),
                        Row(
                          crossAxisAlignment: CrossAxisAlignment.start,
                          children: [
                            Expanded(
                              child: TextField(
                                controller: _aiTextCtrl,
                                minLines: 1,
                                maxLines: 3,
                                textInputAction: TextInputAction.done,
                                onSubmitted: (_) => _applyAiTextFill(),
                                decoration: const InputDecoration(
                                  hintText: '例：午餐花了28.5 / 昨天支付宝地铁4元',
                                  border: OutlineInputBorder(),
                                  isDense: true,
                                ),
                              ),
                            ),
                            const SizedBox(width: 8),
                            IconButton.filledTonal(
                              tooltip: _speechListening
                                  ? '停止录音'
                                  : '语音填单',
                              onPressed: _saving ? null : _toggleVoiceFill,
                              icon: Icon(
                                _speechListening ? Icons.mic : Icons.mic_none,
                                color: _speechListening
                                    ? Theme.of(context).colorScheme.error
                                    : null,
                              ),
                            ),
                            const SizedBox(width: 4),
                            FilledButton(
                              onPressed: (_saving || _aiFilling)
                                  ? null
                                  : _applyAiTextFill,
                              child: Text(_aiFilling ? '…' : '填入'),
                            ),
                          ],
                        ),
                      ],
                    ],
                  ),
                ),

                Padding(
                  padding: const EdgeInsets.symmetric(vertical: 8),
                  child: Column(
                    children: [
                      if (_amountHasOperator)
                        Padding(
                          padding: const EdgeInsets.only(bottom: 4),
                          child: Text(
                            _amountText,
                            style: Theme.of(context)
                                .textTheme
                                .titleMedium
                                ?.copyWith(
                                  color: Theme.of(context)
                                      .colorScheme
                                      .onSurfaceVariant,
                                ),
                          ),
                        ),
                      Text(
                        formatMinor(
                          _currency,
                          toMinor(
                            _currency,
                            _evalAmount(_amountText) ?? 0,
                          ),
                        ),
                        style:
                            Theme.of(context).textTheme.displaySmall?.copyWith(
                                  fontWeight: FontWeight.w600,
                                ),
                      ),
                    ],
                  ),
                ),
                Padding(
                  padding: const EdgeInsets.symmetric(horizontal: 16),
                  child: TextField(
                    controller: _noteCtrl,
                    decoration: const InputDecoration(
                      hintText: '\u5907\u6ce8',
                      border: OutlineInputBorder(),
                      isDense: true,
                    ),
                  ),
                ),
                if (_type != 'transfer') ...[
                  const SizedBox(height: 12),
                  SizedBox(
                    height: 40,
                    child: ListView(
                      scrollDirection: Axis.horizontal,
                      padding: const EdgeInsets.symmetric(horizontal: 16),
                      children: [
                        for (final c in _categories)
                          Padding(
                            padding: const EdgeInsets.only(right: 8),
                            child: ChoiceChip(
                              label: Text(c.name),
                              selected: _categoryId == c.id,
                              onSelected: (_) =>
                                  setState(() => _categoryId = c.id),
                            ),
                          ),
                        Padding(
                          padding: const EdgeInsets.only(right: 8),
                          child: ActionChip(
                            label: const Text('\u66f4\u591a'),
                            avatar: const Icon(Icons.tune, size: 18),
                            onPressed: () async {
                              await context.push('/me/categories');
                              if (mounted) await _reloadCategories();
                            },
                          ),
                        ),
                      ],
                    ),
                  ),
                ],
                if (_type == 'transfer') ...[
                  Padding(
                    padding: const EdgeInsets.fromLTRB(16, 12, 16, 0),
                    child: Row(
                      children: [
                        SizedBox(
                          width: 56,
                          child: Text('\u8f6c\u51fa',
                              style: Theme.of(context).textTheme.labelLarge),
                        ),
                        Expanded(
                          child: DropdownButtonFormField<String>(
                            key: ValueKey('dd-$_fieldEpoch-${_accountId}_${_toAccountId}_$_type'),
                            initialValue: _accountId,
                            items: [
                              for (final a in _accounts)
                                DropdownMenuItem(
                                  value: a.id,
                                  child: Text('${a.name} (${a.currency})'),
                                ),
                            ],
                            onChanged: (v) => setState(() => _accountId = v),
                            decoration: const InputDecoration(
                              isDense: true,
                              border: OutlineInputBorder(),
                            ),
                          ),
                        ),
                      ],
                    ),
                  ),
                  Padding(
                    padding: const EdgeInsets.fromLTRB(16, 8, 16, 0),
                    child: Row(
                      children: [
                        SizedBox(
                          width: 56,
                          child: Text('\u8f6c\u5165',
                              style: Theme.of(context).textTheme.labelLarge),
                        ),
                        Expanded(
                          child: DropdownButtonFormField<String>(
                            key: ValueKey('dd-$_fieldEpoch-${_accountId}_${_toAccountId}_$_type'),
                            initialValue: _toAccountId,
                            items: [
                              for (final a in _accounts)
                                DropdownMenuItem(
                                  value: a.id,
                                  child: Text('${a.name} (${a.currency})'),
                                ),
                            ],
                            onChanged: (v) => setState(() => _toAccountId = v),
                            decoration: const InputDecoration(
                              isDense: true,
                              border: OutlineInputBorder(),
                            ),
                          ),
                        ),
                      ],
                    ),
                  ),
                  if (_isCrossCurrency)
                    Padding(
                      padding: const EdgeInsets.fromLTRB(16, 8, 16, 0),
                      child: Text(
                        '\u8de8\u5e01\uff1a\u4fdd\u5b58\u65f6\u5c06\u8be2\u95ee\u5bf9\u65b9\u91d1\u989d\u6216\u6c47\u7387',
                        style: Theme.of(context).textTheme.bodySmall?.copyWith(
                              color: scheme.onSurfaceVariant,
                            ),
                      ),
                    ),
                ] else
                  Padding(
                    padding: const EdgeInsets.fromLTRB(16, 12, 16, 0),
                    child: Row(
                      children: [
                        const Text('\u8d26\u6237'),
                        const SizedBox(width: 12),
                        Expanded(
                          child: DropdownButtonFormField<String>(
                            key: ValueKey('dd-$_fieldEpoch-${_accountId}_${_toAccountId}_$_type'),
                            initialValue: _accountId,
                            items: [
                              for (final a in _accounts)
                                DropdownMenuItem(
                                  value: a.id,
                                  child: Text('${a.name} (${a.currency})'),
                                ),
                            ],
                            onChanged: (v) => setState(() => _accountId = v),
                            decoration: const InputDecoration(
                              isDense: true,
                              border: OutlineInputBorder(),
                            ),
                          ),
                        ),
                      ],
                    ),
                  ),
                Padding(
                  padding: const EdgeInsets.fromLTRB(16, 8, 16, 0),
                  child: InkWell(
                    borderRadius: BorderRadius.circular(8),
                    onTap: _pickHappenAt,
                    child: Padding(
                      padding: const EdgeInsets.symmetric(vertical: 8),
                      child: Row(
                        children: [
                          Icon(
                            Icons.schedule,
                            size: 20,
                            color: scheme.onSurfaceVariant,
                          ),
                          const SizedBox(width: 8),
                          Text(
                            '日期',
                            style: Theme.of(context).textTheme.labelLarge,
                          ),
                          const SizedBox(width: 8),
                          Expanded(
                            child: Text(
                              _happenAtLabel,
                              textAlign: TextAlign.end,
                              style: Theme.of(context).textTheme.bodyLarge,
                            ),
                          ),
                          Icon(
                            Icons.chevron_right,
                            color: scheme.onSurfaceVariant,
                          ),
                        ],
                      ),
                    ),
                  ),
                ),
                const Spacer(),
                _Keypad(
                  onKey: _onKey,
                  onSubmit: _saving ? null : () => _save(),
                  onLongSubmit: (_saving || widget.existing != null)
                      ? null
                      : () => _save(keepOpen: true),
                ),
              ],
            ),
    );
  }
}

class _Keypad extends StatelessWidget {
  const _Keypad({
    required this.onKey,
    required this.onSubmit,
    this.onLongSubmit,
  });

  final void Function(String key) onKey;
  final VoidCallback? onSubmit;
  /// Long-press on check: save and keep sheet open (再记一笔).
  final VoidCallback? onLongSubmit;

  static const _keys = [
    ['1', '2', '3', '\u232b'],
    ['4', '5', '6', '+'],
    ['7', '8', '9', '-'],
    ['.', '0', '00', '\u2713'],
  ];

  @override
  Widget build(BuildContext context) {
    final scheme = Theme.of(context).colorScheme;
    return Padding(
      padding: const EdgeInsets.fromLTRB(8, 0, 8, 8),
      child: Column(
        children: [
          for (final row in _keys)
            Row(
              children: [
                for (final k in row)
                  Expanded(
                    child: Padding(
                      padding: const EdgeInsets.all(4),
                      child: SizedBox(
                        height: 52,
                        child: FilledButton.tonal(
                          style: FilledButton.styleFrom(
                            backgroundColor: k == '\u2713'
                                ? scheme.primary
                                : scheme.surfaceContainerHighest,
                            foregroundColor: k == '\u2713'
                                ? scheme.onPrimary
                                : scheme.onSurface,
                          ),
                          onPressed: () {
                            if (k == '\u2713') {
                              onSubmit?.call();
                            } else {
                              onKey(k);
                            }
                          },
                          onLongPress: k == '\u2713' ? onLongSubmit : null,
                          child: Text(
                            k,
                            style: const TextStyle(
                                fontSize: 20, fontWeight: FontWeight.w600),
                          ),
                        ),
                      ),
                    ),
                  ),
              ],
            ),
        ],
      ),
    );
  }
}