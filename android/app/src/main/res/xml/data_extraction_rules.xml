<?xml version="1.0" encoding="utf-8"?>
<!--
  Centli keeps ledgers on-device only. Disable cloud/device-transfer backup so a
  "fresh install" is not silently restored with onboarding_done=true (which
  skips the first-run guide).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
