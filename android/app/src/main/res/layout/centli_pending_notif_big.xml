<?xml version="1.0" encoding="utf-8"?>
<!-- 展开态：确认弹悬浮窗；详情进 App -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/tv_notif_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#FF1A1A1A"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_notif_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="6"
        android:textColor="#FF5C5C5C"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_notif_ignore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/centli_notif_btn_ignore"
            android:paddingLeft="14dp"
            android:paddingTop="8dp"
            android:paddingRight="14dp"
            android:paddingBottom="8dp"
            android:text="忽略"
            android:textColor="#FF333333"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_notif_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/centli_notif_btn_ignore"
            android:paddingLeft="14dp"
            android:paddingTop="8dp"
            android:paddingRight="14dp"
            android:paddingBottom="8dp"
            android:text="详情"
            android:textColor="#FF333333"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btn_notif_confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/centli_notif_btn_confirm"
            android:paddingLeft="14dp"
            android:paddingTop="8dp"
            android:paddingRight="14dp"
            android:paddingBottom="8dp"
            android:text="确认"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
