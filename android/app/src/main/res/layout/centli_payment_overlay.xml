<?xml version="1.0" encoding="utf-8"?>
<!-- 确认卡：居中 + 常规遮罩；默认即答案，一点入账。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/panel_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/centli_overlay_card"
        android:elevation="16dp"
        android:maxWidth="332dp"
        android:orientation="vertical"
        android:paddingHorizontal="13dp"
        android:paddingTop="13dp"
        android:paddingBottom="11dp">

        <LinearLayout
            android:id="@+id/content_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 顶栏：来源 · 时间 | 来自通知 | 遮罩 | 关闭 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_source_meta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="微信支付 · —"
                    android:textColor="#FF666666"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tv_from_tag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/centli_overlay_tag"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="3dp"
                    android:text="来自通知"
                    android:textColor="#FF6BB89A"
                    android:textSize="10sp" />

                <!-- 账本切换（点来源旁隐藏入口，保留能力） -->
                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btn_mask_amount"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="2dp"
                    android:background="@drawable/centli_overlay_icon_btn"
                    android:contentDescription="隐藏金额"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/ic_menu_view" />

                <ImageButton
                    android:id="@+id/btn_close_x"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/centli_overlay_icon_btn"
                    android:contentDescription="收起"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/ic_menu_close_clear_cancel" />
            </LinearLayout>

            <!-- 商户 · 账户副标 -->
            <TextView
                android:id="@+id/tv_merchant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="—"
                android:textColor="#FF1A1A1A"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <!-- 金额（大号；可点改） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_amount_currency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¥"
                    android:textColor="#FF666666"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:background="@null"
                    android:fontFamily="monospace"
                    android:hint="0.00"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="numberDecimal"
                    android:maxLines="1"
                    android:minWidth="72dp"
                    android:textColor="#FF1A1A1A"
                    android:textColorHint="#FFBBBBBB"
                    android:textSize="34sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_amount_masked"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:letterSpacing="0.12"
                    android:text="•••"
                    android:textColor="#FF999999"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 分类 chips + 更多（卡内展开） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:text="分类"
                    android:textColor="#FF666666"
                    android:textSize="11.5sp" />

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/row_category_chips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="9dp">

                        <TextView
                            android:id="@+id/chip_cat_0"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/centli_overlay_chip"
                            android:gravity="center"
                            android:minWidth="48dp"
                            android:paddingHorizontal="13dp"
                            android:text="—"
                            android:textColor="#FF666666"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/chip_cat_1"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/centli_overlay_chip"
                            android:gravity="center"
                            android:minWidth="48dp"
                            android:paddingHorizontal="13dp"
                            android:text="—"
                            android:textColor="#FF666666"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/chip_cat_2"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/centli_overlay_chip"
                            android:gravity="center"
                            android:minWidth="48dp"
                            android:paddingHorizontal="13dp"
                            android:text="—"
                            android:textColor="#FF666666"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/chip_cat_more"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:background="@drawable/centli_overlay_chip"
                            android:gravity="center"
                            android:paddingHorizontal="8dp"
                            android:text="更多"
                            android:textColor="#FF888888"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- 分类「更多」卡内展开（默认隐藏） -->
            <LinearLayout
                android:id="@+id/panel_category_more"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/row_category_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btn_cat_back"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingVertical="4dp"
                        android:paddingEnd="8dp"
                        android:text="‹ 返回"
                        android:textColor="#FF8B84D6"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_cat_level"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="选择分类"
                        android:textColor="#FF888888"
                        android:textSize="11sp" />
                </LinearLayout>

                <ScrollView
                    android:id="@+id/scroll_categories"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/container_categories"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>

            <!-- 兼容旧 ID（gone） -->
            <TextView
                android:id="@+id/tv_category_summary_value"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/row_category_summary"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:orientation="horizontal"
                android:visibility="gone" />

            <!-- 账户常显网格 -->
            <TextView
                android:id="@+id/tv_account_level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="账户"
                android:textColor="#FF666666"
                android:textSize="11.5sp" />

            <ScrollView
                android:id="@+id/scroll_accounts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/container_accounts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <!-- 兼容旧摘要行 ID -->
            <LinearLayout
                android:id="@+id/row_account_summary"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_account_summary_label"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />

                <TextView
                    android:id="@+id/tv_account_summary_value"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />
            </LinearLayout>

            <!-- 转账转入网格 -->
            <TextView
                android:id="@+id/tv_to_account_level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="转入"
                android:textColor="#FF666666"
                android:textSize="11.5sp"
                android:visibility="gone" />

            <ScrollView
                android:id="@+id/scroll_to_accounts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/container_to_accounts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>

            <LinearLayout
                android:id="@+id/row_to_account_summary"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_to_account_summary_value"
                    android:layout_width="0dp"
                    android:layout_height="0dp" />
            </LinearLayout>

            <!-- 方向（默认隐藏；转账时由代码显示） -->
            <LinearLayout
                android:id="@+id/row_direction"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btn_dir_out"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/centli_overlay_chip"
                    android:gravity="center"
                    android:text="支出"
                    android:textColor="#FF6C6558"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_dir_in"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/centli_overlay_chip"
                    android:gravity="center"
                    android:text="收入"
                    android:textColor="#FF6C6558"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_dir_transfer"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/centli_overlay_chip"
                    android:gravity="center"
                    android:text="转账"
                    android:textColor="#FF6C6558"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 备注隐藏：商户即主文案；仍保留 ID 供入账写入 -->
            <EditText
                android:id="@+id/et_note"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:importantForAutofill="no"
                android:inputType="text"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_pref_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp"
                android:text="已按历史记录预填，直接确认即可"
                android:textColor="#FF888888"
                android:textSize="10.5sp" />

            <Button
                android:id="@+id/btn_confirm"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:alpha="0.5"
                android:background="@drawable/centli_overlay_btn_primary"
                android:enabled="false"
                android:text="入账"
                android:textAllCaps="false"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/row_secondary_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_ignore"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:paddingHorizontal="13dp"
                    android:text="忽略"
                    android:textColor="#FF5B4B8A"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="·"
                    android:textColor="#668B84D6"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btn_later"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:paddingHorizontal="13dp"
                    android:text="稍后"
                    android:textColor="#FF5B4B8A"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_open_detail"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- 已入账 -->
        <LinearLayout
            android:id="@+id/content_success"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                    android:text="已入账"
                android:textColor="#FF1A1A1A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_success_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text=""
                android:textColor="#FF666666"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
